# Beads: the Dolt working copy and local state. The tracker lives in Dolt and syncs
# through refs/dolt/data on the git remote; issues.jsonl is the tracked export and
# the interaction log is local churn.
.beads/embeddeddolt/
.beads/backup/
.beads/last-touched
.beads/export-state.json
.beads/interactions.jsonl

# Pipeline work files (repair lists, markers)
references/work/

# Row worktrees. `bd worktree create <id>` puts one at ./<id> and every row id
# carries the tracker's prefix, so the whole class is ignored here rather than a
# line per worktree. bd still writes and removes its own entry for each one; the
# two cancel and neither is committed.
/fiddlybits-*/
